rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users collection ───
    // All authenticated users can read any user profile (needed for admin panel, teacher lists, etc.)
    // Users can only create/update their own profile
    // Role and approval fields are protected on the client side and validated by app logic
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        // Allow any authenticated user to update (admin checks done in app)
        // Firestore rules can't easily do recursive admin checks without get() cost
        request.auth != null
      );
    }

    // ─── Rooms ───
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ─── Recordings ───
    match /recordings/{recordingId} {
      allow read, write: if request.auth != null;
    }

    // ─── Attendance ───
    match /attendance/{docId} {
      allow read, write: if request.auth != null;
    }

    // ─── Join Requests (Lobby system) ───
    // Students create requests, teachers accept/decline, students can delete their own
    match /joinRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ─── Enrollment Requests ───
    match /enrollmentRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // ─── Payment Requests ───
    match /paymentRequests/{requestId} {
      allow read, write: if request.auth != null;
    }
  }
}
